# Only needed for server mode (Settings → "Through the local NodeStorm server").
# Which provider to use by default: siliconflow | anthropic | deepseek | moonshot | zhipu | dashscope | ollama | openai | mock
AI_PROVIDER=siliconflow

# SiliconFlow (https://cloud.siliconflow.cn) — OpenAI-compatible API
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Set to 1 to let Claude use web search when naming / finding relations
ANTHROPIC_WEB_SEARCH=0

# Other OpenAI-compatible services (optional); each also takes <NAME>_BASE_URL
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# Ollama needs no key; OLLAMA_BASE_URL defaults to http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Any other OpenAI-compatible endpoint (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PORT=8787
# Only this computer can reach the server by default. It has no login and spends the keys above, so only set
# HOST=0.0.0.0 (all interfaces) behind your own authentication.
# HOST=127.0.0.1
