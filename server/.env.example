# Which provider to use by default: siliconflow | anthropic | openai | mock
AI_PROVIDER=siliconflow

# SiliconFlow (https://cloud.siliconflow.cn) — OpenAI-compatible API
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Set to 1 to let Claude use web search when naming / finding relations
ANTHROPIC_WEB_SEARCH=0

# Any other OpenAI-compatible endpoint (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PORT=8787
